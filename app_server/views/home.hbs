<section class="hero">
  <h2>Welcome to Travlr Getaways</h2>
  <p>Discover featured trips.</p>
</section>

<section class="featured">
  <h3>Featured Trips</h3>
  <div class="cards">
    {{#each featured}}
      <article class="card">
        <h4>{{this.title}}</h4>
        <p><strong>Location:</strong> {{this.location}}</p>
        <p>{{this.description}}</p>
        <p><strong>Price:</strong> ${{this.price}}</p>
      </article>
    {{/each}}
  </div>
</section>
